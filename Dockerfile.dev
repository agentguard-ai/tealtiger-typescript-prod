# TealTiger TypeScript SDK - Development Image
# Includes dev tools, testing frameworks, and debugging utilities

FROM node:20-alpine

LABEL maintainer="TealTiger Team <support@tealtiger.co.in>"
LABEL description="TealTiger TypeScript SDK - Development Environment"

WORKDIR /app

# Install system dependencies
RUN apk add --no-cache \
    git \
    bash \
    vim \
    curl

# Copy package files
COPY package*.json tsconfig.json jest.config.js ./

# Install all dependencies (including dev)
RUN npm ci && \
    npm cache clean --force

# Copy source code
COPY src/ ./src/
COPY examples/ ./examples/
COPY benchmarks/ ./benchmarks/

# Create non-root user
RUN addgroup -g 1000 tealtiger && \
    adduser -D -u 1000 -G tealtiger -s /bin/bash tealtiger && \
    chown -R tealtiger:tealtiger /app

USER tealtiger

# Set environment variables
ENV NODE_ENV=development

# Default command
CMD ["bash"]
