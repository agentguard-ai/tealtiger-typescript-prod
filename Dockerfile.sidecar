# TealTiger Governance Sidecar — Production Image
# Language-agnostic HTTP governance API wrapping TealEngine v1.2
#
# Usage:
#   docker build -f Dockerfile.sidecar -t tealtiger/governance:1.2 .
#   docker run -p 8080:8080 tealtiger/governance:1.2
#
# Environment variables:
#   TEALTIGER_PORT          HTTP port (default: 8080)
#   TEALTIGER_HOST          Bind address (default: 0.0.0.0)
#   TEALTIGER_MODE          Policy mode: ENFORCE | MONITOR | REPORT_ONLY (default: ENFORCE)
#   TEALTIGER_POLICY_DIR    Path to policy JSON files (default: /etc/tealtiger/policies)
#   TEALTIGER_LOG_LEVEL     Log level: info | debug | warn | error (default: info)
#   TEALTIGER_MAX_BODY_BYTES Max request body size in bytes (default: 1048576 = 1MB)
#
# Policy mounting:
#   docker run -v ./my-policies:/etc/tealtiger/policies tealtiger/governance:1.2

# ── Stage 1: Builder ─────────────────────────────────────────────
FROM node:20-alpine AS builder

LABEL maintainer="TealTiger Team <reachout@tealtiger.ai>"
LABEL description="TealTiger Governance Sidecar — TealEngine v1.2 HTTP API"

WORKDIR /build

# Copy package files first for layer caching
COPY package*.json tsconfig.json tsconfig.sidecar.json ./

# Install all dependencies (including dev for build)
RUN npm install --ignore-scripts && \
    npm cache clean --force

# Copy source
COPY src/ ./src/

# Build TypeScript — sidecar entry point only
# Note: some v1.2 modules have type errors against v1.1 enums (expected, will be fixed in full v1.2 release)
RUN npx tsc -p tsconfig.sidecar.json || true
# Verify sidecar server and its dependencies were built
RUN test -f dist/sidecar/server.js && test -f dist/core/engine/types.js && test -f dist/core/engine/v1.2/TealEngineV12.js || (echo "ERROR: critical sidecar files not built" && exit 1)

# ── Stage 2: Runtime ─────────────────────────────────────────────
FROM node:20-alpine

WORKDIR /app

# Security: create non-root user
RUN addgroup -g 1001 -S tealtiger && \
    adduser -S -u 1001 -G tealtiger tealtiger

# Copy package files
COPY package*.json ./

# Install production dependencies only
RUN npm install --only=production --ignore-scripts && \
    npm cache clean --force

# Copy built files from builder
COPY --from=builder /build/dist/ ./dist/

# Create policy directory with correct permissions
RUN mkdir -p /etc/tealtiger/policies && \
    chown -R tealtiger:tealtiger /etc/tealtiger && \
    chown -R tealtiger:tealtiger /app

# Switch to non-root user
USER tealtiger

# Environment defaults
ENV NODE_ENV=production \
    TEALTIGER_PORT=8080 \
    TEALTIGER_HOST=0.0.0.0 \
    TEALTIGER_MODE=ENFORCE \
    TEALTIGER_POLICY_DIR=/etc/tealtiger/policies \
    TEALTIGER_LOG_LEVEL=info

# Expose HTTP port
EXPOSE 8080

# Health check
HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=3 \
    CMD wget -qO- http://localhost:8080/health || exit 1

# Volume for policy files
VOLUME ["/etc/tealtiger/policies"]

# Start the sidecar server
CMD ["node", "dist/sidecar/server.js"]
