{
  "name": "tealtiger",
  "version": "1.1.0",
  "description": "TealTiger - Powerful protection for AI agents with cost tracking and security guardrails",
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "bin": {
    "tealtiger": "dist/cli/test.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.esm.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./providers/openai": {
      "import": "./dist/providers/openai.esm.js",
      "require": "./dist/providers/openai.js",
      "types": "./dist/providers/openai.d.ts"
    },
    "./providers/anthropic": {
      "import": "./dist/providers/anthropic.esm.js",
      "require": "./dist/providers/anthropic.js",
      "types": "./dist/providers/anthropic.d.ts"
    },
    "./providers/gemini": {
      "import": "./dist/providers/gemini.esm.js",
      "require": "./dist/providers/gemini.js",
      "types": "./dist/providers/gemini.d.ts"
    },
    "./providers/bedrock": {
      "import": "./dist/providers/bedrock.esm.js",
      "require": "./dist/providers/bedrock.js",
      "types": "./dist/providers/bedrock.d.ts"
    },
    "./providers/azure-openai": {
      "import": "./dist/providers/azure-openai.esm.js",
      "require": "./dist/providers/azure-openai.js",
      "types": "./dist/providers/azure-openai.d.ts"
    },
    "./providers/cohere": {
      "import": "./dist/providers/cohere.esm.js",
      "require": "./dist/providers/cohere.js",
      "types": "./dist/providers/cohere.d.ts"
    },
    "./providers/mistral": {
      "import": "./dist/providers/mistral.esm.js",
      "require": "./dist/providers/mistral.js",
      "types": "./dist/providers/mistral.d.ts"
    },
    "./serverless": {
      "import": "./dist/serverless.esm.js",
      "require": "./dist/serverless.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist/**/*",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "npm run build:rollup && npm run build:types",
    "build:rollup": "rollup -c",
    "build:types": "tsc --emitDeclarationOnly --outDir dist",
    "build:tsc": "tsc",
    "build:watch": "tsc --watch",
    "build:analyze": "rollup -c --environment ANALYZE",
    "build:measure": "npm run build && node scripts/measure-bundle-size.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "benchmark": "ts-node benchmarks/performance.bench.ts",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "docs": "typedoc",
    "clean": "rimraf dist",
    "prepublishOnly": "echo skipping prepublish"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "ai",
    "security",
    "agent",
    "sdk",
    "typescript",
    "javascript",
    "langchain",
    "openai",
    "anthropic",
    "claude",
    "policy",
    "governance",
    "compliance",
    "audit",
    "guardrails",
    "llm",
    "chatbot",
    "automation",
    "middleware",
    "protection"
  ],
  "author": "TealTiger Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/agentguard-ai/tealtiger-typescript.git"
  },
  "bugs": {
    "url": "https://github.com/agentguard-ai/tealtiger-typescript/issues"
  },
  "homepage": "https://tealtiger.co.in",
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.987.0",
    "@azure/openai": "^2.0.0",
    "@google/generative-ai": "^0.24.1",
    "@mistralai/mistralai": "^1.14.0",
    "@types/uuid": "^10.0.0",
    "axios": "^1.6.0",
    "cohere-ai": "^7.20.0",
    "openai": "^6.21.0",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^28.0.2",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^15.3.0",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^12.1.2",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "fast-check": "^4.5.3",
    "jest": "^29.5.0",
    "rimraf": "^5.0.0",
    "rollup": "^4.30.1",
    "rollup-plugin-analyzer": "^4.0.0",
    "rollup-plugin-dts": "^6.1.1",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.0",
    "typedoc": "^0.25.0",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}
